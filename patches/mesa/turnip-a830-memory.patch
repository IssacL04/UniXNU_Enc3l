       dev->vis_stream_size = MAX2(dev->vis_stream_size, max_size);
-      if (dev->vis_stream_bo)
+      /* The old BO goes (each command buffer that used it keeps its own
+       * reference until it is reset), and a failed allocation must not leave
+       * the device pointing at the freed one: its iova would be patched into
+       * this submission's visibility streams.
+       */
+      if (dev->vis_stream_bo) {
          tu_bo_finish(dev, dev->vis_stream_bo);
+         dev->vis_stream_bo = NULL;
+      }
       result = tu_bo_init_new(dev, &dev->vk.base, &dev->vis_stream_bo,
                               dev->vis_stream_size * dev->vis_stream_count, 
                               TU_BO_ALLOC_INTERNAL_RESOURCE,
                               "visibility stream");
+      if (result != VK_SUCCESS) {
+         dev->vis_stream_bo = NULL;
+         mesa_loge("visibility stream of %u x %u bytes: allocation failed (%d)",
+                   dev->vis_stream_count, dev->vis_stream_size, result);
+      } else {
+         mesa_logw("visibility stream now %u x %u bytes",
+                   dev->vis_stream_count, dev->vis_stream_size);
+      }
    }
 
    bo = dev->vis_stream_bo;

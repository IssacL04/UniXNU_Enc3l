+      pthread_mutex_unlock(&device->submit_mutex);
       goto out;
+   }
 
    if (has_trace_points) {
       tu_u_trace_submission_data_create(
diff --git a/src/freedreno/vulkan/tu_cmd_buffer.cc b/src/freedreno/vulkan/tu_cmd_buffer.cc
--- a/src/freedreno/vulkan/tu_cmd_buffer.cc
+++ b/src/freedreno/vulkan/tu_cmd_buffer.cc
@@ -237,11 +237,31 @@
    uint32_t vsc_draw_overflow = global->vsc_draw_overflow;
    uint32_t vsc_prim_overflow = global->vsc_prim_overflow;
 
-   if (vsc_draw_overflow >= dev->vsc_draw_strm_pitch)
+   /* Each overflow doubles a pitch for the device's life, and the device's
+    * visibility stream BO follows it (resolve_vis_stream_patchpoints). On
+    * A8XX the overflow test polls VSC_PIPE_DATA_{DRAW,PRIM}_SIZE, which the
+    * register database lists for A6XX only: bound the growth per pipe
+    * (TU_VSC_MAX_PRIM_KB, default 1024; TU_VSC_MAX_DRAW_KB, default 256) and
+    * say every step, so a run log shows whether and when it grows.
+    */
+   static const uint32_t max_prim =
+      debug_get_num_option("TU_VSC_MAX_PRIM_KB", 1024) * 1024;
+   static const uint32_t max_draw =
+      debug_get_num_option("TU_VSC_MAX_DRAW_KB", 256) * 1024;
+
+   if (vsc_draw_overflow >= dev->vsc_draw_strm_pitch &&
+       dev->vsc_draw_strm_pitch - VSC_PAD < max_draw) {
       dev->vsc_draw_strm_pitch = (dev->vsc_draw_strm_pitch - VSC_PAD) * 2 + VSC_PAD;
+      mesa_logw("VSC draw stream overflow: %u bytes a pipe now",
+                dev->vsc_draw_strm_pitch);
+   }
 
-   if (vsc_prim_overflow >= dev->vsc_prim_strm_pitch)
+   if (vsc_prim_overflow >= dev->vsc_prim_strm_pitch &&
+       dev->vsc_prim_strm_pitch - VSC_PAD < max_prim) {
       dev->vsc_prim_strm_pitch = (dev->vsc_prim_strm_pitch - VSC_PAD) * 2 + VSC_PAD;
+      mesa_logw("VSC primitive stream overflow: %u bytes a pipe now",
+                dev->vsc_prim_strm_pitch);
+   }
 
    cmd->vsc_prim_strm_pitch = dev->vsc_prim_strm_pitch;
    cmd->vsc_draw_strm_pitch = dev->vsc_draw_strm_pitch;
